# Copy this file to .env and fill in the keys you need. .env is gitignored; never commit it.
# Mock mode (python run_crucible.py --mock) and the grader (experiment/grade.py) need no keys.

# Gemini: Crucible live mode, and the evaluated role in experiment/rig/roles.json
GEMINI_API_KEY=

# Anthropic: the competitor role in experiment/rig/roles.json
ANTHROPIC_API_KEY=

# Moonshot Kimi: the observer role in experiment/rig/roles.json (OpenAI-compatible endpoint)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
